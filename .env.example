# Server-side only. Never commit this value or expose it as NEXT_PUBLIC_*.
VAPI_PRIVATE_API_KEY=

# Restricts transcript syncing to the Relay311 inbound number and assistant.
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=

# Optional alternative to polling: a public HTTPS origin Vapi can call.
APP_PUBLIC_URL=

# Shared value sent by Vapi as x-vapi-secret. Generate a long random value.
# Recommended when enabling the webhook.
VAPI_WEBHOOK_SECRET=

# Contact email sent in the User-Agent for OpenStreetMap Nominatim geocoding (required by its usage policy).
GEOCODER_CONTACT_EMAIL=
